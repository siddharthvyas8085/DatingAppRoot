APP_ENV=development
APP_NAME=Dating App API

JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Keep CSV storage as the default for local development. Set USE_SUPABASE=true
# only when the Supabase schema is fully aligned with the app.
USE_SUPABASE=false

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-or-service-key